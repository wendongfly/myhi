{
  "name": "@wendongfly/myhi",
  "version": "1.3.230",
  "description": "Web-based terminal sharing with chat UI — control your terminal from phone via LAN/Tailscale",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "myhi": "bin/myhi.js"
  },
  "files": [
    "bin/",
    "dist/",
    "installer/",
    "THIRD_PARTY_NOTICES.md",
    "licenses/",
    "!installer/**/gateway.json",
    "!installer/**/secrets.json",
    "!installer/**/*.env"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --watch src/server.js",
    "build": "node scripts/build.js",
    "prepublishOnly": "node scripts/build.js",
    "postinstall": "node -e \"try{require('fs').chmodSync(require('path').join(__dirname,'bin','myhi.js'),0o755)}catch(e){}\""
  },
  "keywords": [
    "terminal",
    "web-terminal",
    "claude",
    "claude-code",
    "tailscale",
    "pty",
    "remote-terminal",
    "chat-ui"
  ],
  "author": "wendongfly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wendongfly/myhi.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^2.4.1",
    "socket.io": "^4.8.4",
    "xterm": "^4.19.0",
    "xterm-addon-fit": "^0.5.0",
    "xterm-addon-web-links": "^0.6.0"
  },
  "homepage": "https://github.com/wendongfly/myhi#readme",
  "bugs": {
    "url": "https://github.com/wendongfly/myhi/issues"
  }
}
